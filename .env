# ============================================================
# Mobile DevSecOps Platform — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Backend
SECRET_KEY=change-me-to-a-random-secret

CORS_ORIGINS=http://localhost:5173,http://localhost:80

# MobSF (Docker container — do not change unless custom deployment)
MOBSF_URL=http://mobsf:8000
MOBSF_API_KEY=20d4ecf8654c1e7f7b2060b0b17ee9ad8143b940da5e35f059b66a05d6a1b57f

# AI Triage
AI_PROVIDER=ollama          # "ollama" (local) or "openai"
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3
OPENAI_API_KEY=             # Only needed if AI_PROVIDER=openai

# GitHub API Token for Webhook Commit Status Reporting
GITHUB_TOKEN=
OPENAI_MODEL=gpt-4o

# Pipeline
WORKSPACE_DIR=/tmp/devsecops-workspace
MAX_CONCURRENT_RUNS=3
BUILD_TIMEOUT_SECONDS=600

# Frontend (used at build time)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
